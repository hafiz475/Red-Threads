{
  "name": "red-threads",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "tsx tests/all.test.ts",
    "privacy:check": "tsx scripts/privacy-check.ts",
    "inspect:source": "tsx scripts/inspect-private-source.ts",
    "import:whatsapp": "tsx scripts/import-whatsapp.ts",
    "audit:archive": "tsx scripts/audit-archive.ts",
    "invite:recover": "tsx scripts/recover-invitation.ts",
    "verify:encrypted": "tsx scripts/verify-encrypted.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
